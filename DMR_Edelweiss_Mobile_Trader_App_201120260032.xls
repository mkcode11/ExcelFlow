    <script>
        $(function () {
            var dateFormat = "dd MM yy",
              from = $("#dtDateFrom")
                .datepicker({
                    
                    changeMonth: true,
                    changeYear: true,
                    numberOfMonths: 1,
                    dateFormat: dateFormat,
                    maxDate: "-7D"
                })
                .on("change", function () {
                    to.datepicker("option", "minDate", getDate(this));
                    var todate = new Date(getDate(this));
                    var fd = new Date(todate.setDate(todate.getDate() + 6));
                    if (fd > new Date())
                    {
                        fd = new Date();
                    }
                    to.datepicker("option", "maxDate", fd);
                }),
              to = $("#dtDateTo").datepicker({
                  
                  changeMonth: true,
                  changeYear: true,
                  dateFormat: dateFormat,
                  numberOfMonths: 1
              })
              .on("change", function () {
                  from.datepicker("option", "maxDate", getDate(this));
              });

            fromMonth = $("#dtDateFromMonthly")
                .datepicker({
                    changeMonth: true,
                    changeYear: true,
                    showButtonPanel: true,
                    dateFormat: 'MM yy',
                    maxDate: "+0D",
                    onClose: function (dateText, inst) {
                        $(this).datepicker('setDate', new Date(inst.selectedYear, inst.selectedMonth, 1));
                    }
                });

            fromCompare = $("#dtDateFromCompare")
                .datepicker({
                    defaultDate: "+0D",
                    changeMonth: true,
                    changeYear: true,
                    numberOfMonths: 3,
                    maxDate: "+0D"
                })
                .on("change", function () {
                    toCompare.datepicker("option", "minDate", getDate(this));
                }),
              toCompare = $("#dtDateToCompare").datepicker({
                  defaultDate: "+0D",
                  changeMonth: true,
                  changeYear: true,
                  numberOfMonths: 3,
                  maxDate: "+0D"
              });
            //Log View Date Control
            dtDateLog = $(".dtDateLog")
                .datepicker({
                    changeMonth: true,
                    changeYear: true,
                    dateFormat: dateFormat,
                    maxDate: "+0D"
                });

            //Log View Download Date Control
            dtDateLogDownload = $(".dtDateLogDownload")
                .datepicker({
                    changeMonth: true,
                    changeYear: true,
                    dateFormat: dateFormat,
                    maxDate: "+0D"
                });
            //DownTime Log Date Control
            dtDateLogDownload = $(".dtEDDownTime")
                .datepicker({
                    changeMonth: true,
                    changeYear: true,
                    dateFormat: dateFormat,
                    maxDate: "+0D"
                });
            //Dashboard EOD Date Control
            dtDateLogDownload = $(".dtCDEOD")
                .datepicker({
                    changeMonth: true,
                    changeYear: true,
                    dateFormat: dateFormat,
                    maxDate: "-1D"
                });

            function getDate(element) {
                var date;
                try {
                    date = $.datepicker.parseDate(dateFormat, element.value);
                } catch (error) {
                    date = null;
                }

                return date;
            }
        });
    </script>
